{
  "name": "pulse-edge-gateway",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "On-site agent that polls a deployed device (Modbus TCP) and forwards telemetry to Pulse /iot/ingest.",
  "bin": {
    "pulse-edge-gateway": "gateway.mjs",
    "pulse-verify": "verify.mjs"
  },
  "scripts": {
    "start": "node gateway.mjs",
    "test": "node --test __tests__/*.test.mjs",
    "verify": "node verify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "modbus-serial": "^8.0.25"
  }
}
