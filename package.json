{
  "name": "pulse-erp",
  "private": true,
  "description": "Pulse ERP monorepo root — not a deployable package. Deploy targets: backend/ and frontend/. Hosts the Playwright e2e suite (tests/).",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "analyze": "node scripts-analysis/analyze.js",
    "analyze:frontend": "node -e \"import('./scripts-analysis/frontend-analysis.js').then(async m=>{const{RunLog}=await import('./scripts-analysis/lib/exec.js');const{ensureDirs}=await import('./scripts-analysis/lib/fsx.js');ensureDirs();m.runFrontendAnalysis(new RunLog())})\"",
    "analyze:backend": "node -e \"import('./scripts-analysis/backend-analysis.js').then(async m=>{const{RunLog}=await import('./scripts-analysis/lib/exec.js');const{ensureDirs}=await import('./scripts-analysis/lib/fsx.js');ensureDirs();m.runBackendAnalysis(new RunLog())})\"",
    "test:auth": "playwright test --project=setup",
    "test:smoke": "playwright test --project=smoke",
    "test:smoke:p0": "playwright test --project=smoke --grep @P0",
    "test:smoke:p1": "playwright test --project=smoke --grep \"@P0|@P1\"",
    "test:navigation": "playwright test --project=navigation",
    "test:crud": "playwright test --project=crud-employees --project=crud-leaves --project=crud-procurement",
    "test:dashboard": "playwright test --project=dashboard",
    "test:forms": "playwright test --project=forms",
    "test:all": "playwright test --project=smoke --project=navigation --project=dashboard --project=crud-employees --project=crud-leaves --project=crud-procurement --project=forms",
    "test:api-health": "playwright test --project=api-health",
    "test:db-consistency": "playwright test --project=db-consistency",
    "test:dashboard-recon": "playwright test --project=dashboard-reconciliation",
    "test:route-discovery": "playwright test --project=route-discovery",
    "test:full-audit": "playwright test --project=api-health --project=smoke --project=navigation --project=dashboard --project=crud-employees --project=crud-leaves --project=crud-procurement --project=forms --project=db-consistency --project=dashboard-reconciliation --project=route-discovery",
    "test:production-readiness": "playwright test --project=api-health --project=smoke --project=dashboard --project=crud-employees --project=dashboard-reconciliation --project=route-discovery",
    "audit:discover": "playwright test --project=action-discovery",
    "audit:safe": "playwright test --project=safe-actions",
    "audit:forms": "playwright test --project=form-actions",
    "audit:approvals": "playwright test --project=approval-workflows",
    "audit:dangerous": "playwright test --project=dangerous-actions",
    "audit:dashboards": "playwright test --project=dashboard-validation",
    "audit:report": "playwright test --project=action-audit-report",
    "audit:all": "playwright test --project=action-discovery --project=safe-actions --project=form-actions --project=approval-workflows --project=dangerous-actions --project=dashboard-validation --project=action-audit-report",
    "report": "playwright show-report tests/reports/html",
    "report:bugs": "start tests/reports/bug-report.html",
    "report:readiness": "start tests/reports/production-readiness-report.md",
    "report:api": "start tests/reports/api-health-report.json",
    "report:routes": "start tests/reports/route-gap-analysis.md",
    "report:audit": "start tests/reports/action-audit-report.html",
    "test:analytics": "playwright test --project=analytics-contract --project=tenant-isolation --project=analytics-browser",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.20.0",
    "madge": "^8.0.0"
  }
}
